rces(s).map((x) => x.src)\n  assert.ok(src[0].startsWith(`https://stream.mux.com/${s.playbackId}.m3u8`))\n  assert.ok(src.includes(`https://stream.mux.com/${s.playbackId}/720p.mp4`))\n  assert.ok(src.includes(`https://stream.mux.com/${s.playbackId}/1080p.mp4`))\n})\n"]}}