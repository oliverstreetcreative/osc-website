generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  CREW
  STAFF
}

// ---------------------------------------------------------------------------
// People (unified clients + crew + staff)
// Replaces the former PortalUser model.
// ---------------------------------------------------------------------------

model Person {
  id             String  @id @default(uuid()) @db.Uuid
  email          String  @unique
  name           String
  first_name     String?
  last_name      String?
  company        String?
  phone          String?
  is_staff       Boolean @default(false)
  portal_allowed Boolean @default(true)
  role           Role

  // Publication metadata
  source_bible_id     Int?
  source_bible_table  String?
  published_at        DateTime @default(now())
  publication_version Int      @default(1)

  // Client site (2026-10)
  memberships    Membership[]
  project_requests ProjectRequest[]
  calendar_token String?      @unique // private ICS feed: /calendar/<token>.ics
  script_clients ScriptClient[]
  script_access  ScriptAccess[]
  script_notices ScriptNotice[]

  // Relations
  project_contacts      ProjectContact[]
  project_participants  ProjectParticipant[]
  deliverable_reviews   DeliverableReview[]
  deliverable_approvals DeliverableApproval[]
  portal_uploads        PortalUpload[]
  portal_events         PortalEvent[]
  portal_invites        PortalInvite[]
  portal_sessions       PortalSession[]
  testimonials          Testimonial[]
  trips                 Trip[]
  assigned_tasks        Task[]
  error_reports         PortalErrorReport[]

  @@index([source_bible_id, source_bible_table], name: "idx_people_source_bible")
  @@map("people")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id                    String  @id @default(uuid()) @db.Uuid
  name                  String
  status                String  @default("active")
  phase                 String  @default("Proposal")
  job_number            String?
  client_portal_enabled Boolean @default(false)
  client_visible        Boolean @default(false)
  crew_visible          Boolean @default(false)

  // Publication metadata
  source_bible_id     Int?
  source_bible_table  String?
  published_at        DateTime @default(now())
  publication_version Int      @default(1)

  // Client site (2026-10): curated, client-safe fields from the client book
  ext_key         String?       @unique
  organization_id String?       @db.Uuid
  slug            String?
  kind            String?
  summary         String?
  status_line     String?
  next_step       String?
  poster_path     String?
  poster_mux_id   String?
  poster_time     Float?
  dates           Json?
  team            Json?
  sort_date       DateTime?
  hidden          Boolean       @default(false)
  from_request    String? // a client's "Start a new project" request this project answers (SPEC §17)
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  invoices        Invoice[]
  documents       Document[]
  scripts         Script[]

  // Relations
  project_contacts     ProjectContact[]
  project_participants ProjectParticipant[]
  deliverables         Deliverable[]
  project_updates      ProjectUpdate[]
  change_orders        ChangeOrder[]
  obligations          Obligation[]
  shoot_periods        ShootPeriod[]
  trips                Trip[]
  tasks                Task[]
  portal_uploads       PortalUpload[]
  portal_events        PortalEvent[]
  testimonials         Testimonial[]
  error_reports        PortalErrorReport[]

  @@index([source_bible_id, source_bible_table], name: "idx_projects_source_bible")
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Project Contacts (project → person join, client side)
// ---------------------------------------------------------------------------

model ProjectContact {
  id         String @id @default(uuid()) @db.Uuid
  project_id String @db.Uuid
  person_id  String @db.Uuid
  role       String @default("client")

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([person_id, project_id])
  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_project_contacts_source_bible")
  @@map("project_contacts")
}

// ---------------------------------------------------------------------------
// Project Participants (project → person join, crew side)
// ---------------------------------------------------------------------------

model ProjectParticipant {
  id           String  @id @default(uuid()) @db.Uuid
  project_id   String  @db.Uuid
  person_id    String  @db.Uuid
  role         String
  crew_visible Boolean @default(false)

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([person_id, project_id])
  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_project_participants_source_bible")
  @@map("project_participants")
}

// ---------------------------------------------------------------------------
// Deliverables
// ---------------------------------------------------------------------------

model Deliverable {
  id                 String    @id @default(uuid()) @db.Uuid
  project_id         String    @db.Uuid
  name               String
  deliverable_type   String    @default("video")
  description        String?
  client_visible     Boolean   @default(false)
  review_status      String    @default("Not Ready")
  current_version    Int       @default(1)
  dropbox_replay_url String?
  shared_at          DateTime?

  // Publication metadata
  source_bible_id     Int?
  source_bible_table  String?
  published_at        DateTime @default(now())
  publication_version Int      @default(1)

  // Client site (2026-10)
  ext_key         String?   @unique
  mux_playback_id String?
  file_path       String?
  aspect          String?
  poster_path     String?
  poster_time     Float?
  duration_s      Int?
  version_label   String?
  watch_url       String?
  review_url      String?
  // SPEC §13 v4: the Review share link's asset (versions are read live from Review), who approves, and what Sam asks
  review_asset_id String?
  version_review_id String? // the Review version Sam's version_label names (shown/frozen only for that one)
  approvers       Json? // emails (gated: book people only)
  approval        String    @default("any") // any | all
  ask             String    @default("none") // none | notes | ok
  version_approvals VersionApproval[]
  downloads       Json?
  delivered_at    DateTime?
  sort            Int       @default(0)
  hidden          Boolean   @default(false)

  // Relations
  project               Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  deliverable_reviews   DeliverableReview[]
  deliverable_approvals DeliverableApproval[]
  scripts               Script[]

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_deliverables_source_bible")
  @@map("deliverables")
}

// ---------------------------------------------------------------------------
// Deliverable Reviews
// ---------------------------------------------------------------------------

model DeliverableReview {
  id               String   @id @default(uuid()) @db.Uuid
  deliverable_id   String   @db.Uuid
  reviewer_id      String   @db.Uuid
  version          Int      @default(1)
  status           String   @default("Pending Review")
  notes            String   @default("")
  timecode_seconds Int?
  decision         String?
  reviewed_at      DateTime

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  deliverable Deliverable @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  reviewer    Person      @relation(fields: [reviewer_id], references: [id], onDelete: Cascade)

  @@index([deliverable_id])
  @@index([source_bible_id, source_bible_table], name: "idx_deliverable_reviews_source_bible")
  @@map("deliverable_reviews")
}

// ---------------------------------------------------------------------------
// Deliverable Approvals
// ---------------------------------------------------------------------------

model DeliverableApproval {
  id             String   @id @default(uuid()) @db.Uuid
  deliverable_id String   @db.Uuid
  approver_id    String   @db.Uuid
  version        Int
  approved       Boolean
  notes          String   @default("")
  decided_at     DateTime

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  deliverable Deliverable @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  approver    Person      @relation(fields: [approver_id], references: [id], onDelete: Cascade)

  @@index([deliverable_id])
  @@index([source_bible_id, source_bible_table], name: "idx_deliverable_approvals_source_bible")
  @@map("deliverable_approvals")
}

// ---------------------------------------------------------------------------
// Project Updates
// ---------------------------------------------------------------------------

model ProjectUpdate {
  id                String    @id @default(uuid()) @db.Uuid
  project_id        String    @db.Uuid
  author            String
  body              String
  attachments       String    @default("")
  client_visible    Boolean   @default(false)
  posted_at         DateTime
  client_reply      String?
  client_replied_at DateTime?

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_project_updates_source_bible")
  @@map("project_updates")
}

// ---------------------------------------------------------------------------
// Change Orders
// ---------------------------------------------------------------------------

model ChangeOrder {
  id             String    @id @default(uuid()) @db.Uuid
  project_id     String    @db.Uuid
  description    String
  cost_impact    Decimal   @db.Decimal(10, 2)
  status         String    @default("Proposed")
  client_visible Boolean   @default(false)
  proposed_at    DateTime
  approved_at    DateTime?
  approved_by    String?

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_change_orders_source_bible")
  @@map("change_orders")
}

// ---------------------------------------------------------------------------
// Obligations (client-facing invoice view)
// ---------------------------------------------------------------------------

model Obligation {
  id              String    @id @default(uuid()) @db.Uuid
  project_id      String    @db.Uuid
  type            String    @default("receivable")
  status          String    @default("pending")
  amount          Decimal   @db.Decimal(10, 2)
  description     String    @default("")
  obligation_date DateTime  @db.Date
  due_date        DateTime  @db.Date
  paid_date       DateTime? @db.Date
  client_visible  Boolean   @default(false)

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_obligations_source_bible")
  @@map("obligations")
}

// ---------------------------------------------------------------------------
// Shoot Periods
// ---------------------------------------------------------------------------

model ShootPeriod {
  id             String   @id @default(uuid()) @db.Uuid
  project_id     String   @db.Uuid
  description    String?
  start_date     DateTime @db.Date
  end_date       DateTime @db.Date
  period_type    String?
  call_time      String?
  client_visible Boolean  @default(false)
  crew_visible   Boolean  @default(false)

  // Publication metadata
  source_bible_id     Int?
  source_bible_table  String?
  published_at        DateTime @default(now())
  publication_version Int      @default(1)

  // Client site (2026-10)
  ext_key  String? @unique
  location String?
  address  String?
  bring    String?
  hidden   Boolean @default(false)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_shoot_periods_source_bible")
  @@map("shoot_periods")
}

// ---------------------------------------------------------------------------
// Trips
// ---------------------------------------------------------------------------

model Trip {
  id             String   @id @default(uuid()) @db.Uuid
  person_id      String   @db.Uuid
  project_id     String?  @db.Uuid
  purpose        String?
  departure_date DateTime @db.Date
  return_date    DateTime @db.Date
  status         String   @default("pending")
  crew_visible   Boolean  @default(false)

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  person  Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_trips_source_bible")
  @@map("trips")
}

// ---------------------------------------------------------------------------
// Tasks (flattened Paperclip issues)
// ---------------------------------------------------------------------------

model Task {
  id                 String  @id @default(uuid()) @db.Uuid
  project_id         String  @db.Uuid
  assignee_person_id String? @db.Uuid
  phase              String?
  title              String
  status             String  @default("todo")
  client_visible     Boolean @default(false)
  crew_visible       Boolean @default(false)
  priority           String?
  blocked_by         Json?

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee Person? @relation(fields: [assignee_person_id], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_tasks_source_bible")
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Portal Uploads
// ---------------------------------------------------------------------------

model PortalUpload {
  id              String   @id @default(uuid()) @db.Uuid
  project_id      String   @db.Uuid
  uploader_id     String   @db.Uuid
  file_name       String
  file_path       String
  file_size_bytes BigInt?
  mime_type       String?
  uploaded_at     DateTime

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploader Person  @relation(fields: [uploader_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_portal_uploads_source_bible")
  @@map("portal_uploads")
}

// ---------------------------------------------------------------------------
// Portal Events (activity feed)
// ---------------------------------------------------------------------------

model PortalEvent {
  id           String    @id @default(uuid()) @db.Uuid
  project_id   String?   @db.Uuid
  person_id    String?   @db.Uuid
  event_type   String
  summary      String
  details      Json?
  occurred_at  DateTime  @default(now())
  processed_at DateTime?

  // Source: who originated this event
  source String // 'portal_client' | 'portal_crew' | 'portal_admin' | 'bible'

  // Publication metadata (null for portal-originated events)
  source_bible_id     Int?
  source_bible_table  String?
  published_at        DateTime?
  publication_version Int?      @default(1)

  // Relations
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  person  Person?  @relation(fields: [person_id], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([processed_at], name: "idx_portal_events_processed_at")
  @@index([source_bible_id, source_bible_table], name: "idx_portal_events_source_bible")
  @@map("portal_events")
}

// ---------------------------------------------------------------------------
// Portal Invites (portal-native, no publication metadata)
// ---------------------------------------------------------------------------

model PortalInvite {
  id              String    @id @default(uuid()) @db.Uuid
  person_id       String    @db.Uuid
  magic_link_hash String    @unique
  expires_at      DateTime
  accepted_at     DateTime?
  created_at      DateTime  @default(now())

  // Relations
  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@map("portal_invites")
}

// ---------------------------------------------------------------------------
// Portal Sessions (portal-native, no publication metadata)
// ---------------------------------------------------------------------------

model PortalSession {
  id             String    @id @default(uuid()) @db.Uuid
  person_id      String    @db.Uuid
  token_hash     String    @unique
  expires_at     DateTime
  last_active_at DateTime?
  created_at     DateTime  @default(now())

  // Relations
  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@map("portal_sessions")
}

// ---------------------------------------------------------------------------
// Portal Error Reports (portal-native, no publication metadata)
// ---------------------------------------------------------------------------

model PortalErrorReport {
  id                 String    @id @default(uuid()) @db.Uuid
  reporter_id        String    @db.Uuid
  project_id         String?   @db.Uuid
  source_table       String?
  source_bible_id    Int?
  source_bible_table String?
  portal_url         String?
  description        String
  severity           String    @default("moderate")
  status             String    @default("open")
  triaged_at         DateTime?
  triaged_by_agent   String?
  resolved_at        DateTime?
  resolution_notes   String?
  paperclip_issue_id String?
  created_at         DateTime  @default(now())

  // Relations
  reporter Person   @relation(fields: [reporter_id], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([reporter_id])
  @@index([project_id])
  @@index([status])
  @@map("portal_error_reports")
}

// ---------------------------------------------------------------------------
// Testimonials
// ---------------------------------------------------------------------------

model Testimonial {
  id           String   @id @default(uuid()) @db.Uuid
  project_id   String   @db.Uuid
  person_id    String   @db.Uuid
  rating       Int?
  body         String   @default("")
  submitted_at DateTime
  approved     Boolean  @default(false)

  // Publication metadata
  source_bible_id     Int
  source_bible_table  String
  published_at        DateTime
  publication_version Int      @default(1)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([source_bible_id, source_bible_table], name: "idx_testimonials_source_bible")
  @@map("testimonials")
}

// ---------------------------------------------------------------------------
// CLIENT SITE (2026-10). Organizations, memberships, invoices, documents.
// Rows are upserted from the per-client "book" in Dropbox
// (_admin/client-site/books/<slug>.json) by lib/client/sync.ts. The book is
// the allowlist: nothing reaches a client page unless it is in the book.
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  APPROVER
  BILLING
  VIEWER
}

model Organization {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  name          String
  short_name    String?
  logo_path     String?
  website       String?
  billing_email String?
  hidden        Boolean      @default(false)
  synced_at     DateTime     @default(now())
  created_at    DateTime     @default(now())
  memberships   Membership[]
  projects      Project[]
  invoices      Invoice[]
  documents     Document[]
  requests      ProjectRequest[]
  scripts       Script[]
  script_access ScriptAccess[]

  @@map("organizations")
}

model Membership {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  person_id       String       @db.Uuid
  role            MemberRole   @default(VIEWER)
  title           String?
  hidden          Boolean      @default(false)
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person          Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, person_id])
  @@index([person_id])
  @@map("memberships")
}

model Invoice {
  id              String       @id @default(uuid()) @db.Uuid
  number          String       @unique
  organization_id String       @db.Uuid
  project_id      String?      @db.Uuid
  title           String
  amount          Decimal      @db.Decimal(10, 2)
  issued_on       DateTime     @db.Date
  due_on          DateTime?    @db.Date
  paid_on         DateTime?    @db.Date
  status          String       @default("open") // open | paid | void
  pay_url         String?
  pdf_path        String?
  memo            String?
  hidden          Boolean      @default(false)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@map("invoices")
}

model Document {
  id              String       @id @default(uuid()) @db.Uuid
  ext_key         String       @unique
  organization_id String       @db.Uuid
  project_id      String?      @db.Uuid
  kind            String // agreement | proposal | release | call-sheet | license | invoice | receipt | w9 | coi | other
  title           String
  description     String?
  dated_on        DateTime?    @db.Date
  dropbox_path    String?
  url             String?
  mime_type       String?
  size_bytes      Int?
  signed_by       String?
  signed_on       DateTime?    @db.Date
  sha256          String?
  hidden          Boolean      @default(false)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// "Start a new project" requests (SPEC §17). Client-made; never synced from a
// book. Delivered to the existing intake queue (_admin/intake-queue/_new/).
// ---------------------------------------------------------------------------
model ProjectRequest {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  person_id       String       @db.Uuid
  person_name     String
  person_email    String
  kind            String
  like_project    String?
  timing          String
  due_on          DateTime?    @db.Date
  about           String?
  form_key        String       @unique
  status          String       @default("pending") // pending | sent | in_review | closed
  queue_file      String?
  queued_at       DateTime?
  picked_up_at    DateTime?
  closed_at       DateTime?
  attempts        Int          @default(0)
  last_error      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person          Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([status])
  @@map("project_requests")
}

// ---------------------------------------------------------------------------
// The approval of record for a cut (SPEC §13 v4): FROZEN at the moment of
// approval, bound to the exact Review version the client watched. Never
// edited; withdrawing is Sam's explicit act (withdrawn_at). The ledger file in
// Dropbox (_admin/client-site/ledger/approvals/) is what the publish gate's
// lock reads; it is written after the row, retried until it lands.
// ---------------------------------------------------------------------------
model VersionApproval {
  id                String      @id @default(uuid()) @db.Uuid
  deliverable_id    String      @db.Uuid
  organization_id   String      @db.Uuid
  job               String?
  film_key          String // the book's film key
  film_title        String
  review_asset_id   String
  review_version_id String
  review_version_n  Int
  review_posted_at  DateTime?
  version_label     String? // Sam's v-number from the book ("v4")
  filename          String?
  checksum          String?
  person_id         String      @db.Uuid
  name              String
  email             String
  org_name          String
  member_role       String // their role with the client at the time
  note              String?
  how               String      @default("portal") // portal | email (recorded by staff)
  ip                String?
  user_agent        String?
  approved_at       DateTime    @default(now())
  ledger_path       String?
  ledger_written_at DateTime?
  withdrawn_at      DateTime?
  deliverable       Deliverable @relation(fields: [deliverable_id], references: [id], onDelete: Restrict)

  @@unique([deliverable_id, review_version_id, person_id])
  @@index([organization_id])
  @@map("version_approvals")
}

// ---------------------------------------------------------------------------
// SCRIPTS (SPEC §14 v4 "Data model v4, as Prisma", + v5): the client's front
// door for scripting, live co-editing in Yjs. Scripts are ARCHIVED, never
// deleted (archived_at). History tables (updates, versions, comments,
// approvals) keep person ids as plain uuids, no foreign key, so a person
// leaving never erases who wrote what.
// ---------------------------------------------------------------------------

model Script {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String?       @db.Uuid // the client it's shared within (null = OSC-only draft)
  project_id      String?       @db.Uuid
  deliverable_id  String?       @db.Uuid // v1: one script per deliverable
  job             String? // "26-037"
  title           String // "02 Appropriation :30"
  format          String        @default("av") // av | screenplay (v2)
  target_seconds  Int? // from the deliverable's length; null = "no target set"
  pace_wpm        Int           @default(150)
  reader          String? // "Mike Harmon"
  audience        String        @default("office") // office until Sam shares it
  status          String        @default("draft") // draft | ready_for_notes | ready_for_ok | approved
  canonical       String        @default("dropbox") // dropbox (files canonical until Sam OKs production) | portal | gdoc
  read_only       Boolean       @default(false) // true while a Google Doc is canonical (v4 #4)
  shoot_version   Int? // ScriptVersion.n the hub serves on a shoot day
  approvers       Json? // emails, gated like §13
  approval        String        @default("any") // any | all
  source          Json? // import provenance {adapter, path, sha256, label}
  created_by      String        @db.Uuid
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  archived_at     DateTime?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  project         Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  deliverable     Deliverable?  @relation(fields: [deliverable_id], references: [id], onDelete: SetNull)
  updates         ScriptUpdate[]
  snapshots       ScriptSnapshot[]
  clients         ScriptClient[]
  versions        ScriptVersion[]
  access          ScriptAccess[]
  comments        ScriptComment[]
  approvals       ScriptApproval[]
  notices         ScriptNotice[]

  @@index([organization_id])
  @@index([project_id])
  @@map("scripts")
}

model ScriptUpdate {
  // EVERY update kept; id is the DB-assigned seq (v4 #1)
  id         BigInt   @id @default(autoincrement())
  script_id  String   @db.Uuid
  update     Bytes
  person_id  String   @db.Uuid
  client_id  BigInt // the Yjs clientID that made it (bound in ScriptClient)
  created_at DateTime @default(now())
  script     Script   @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@index([script_id, id])
  @@map("script_updates")
}

model ScriptSnapshot {
  // a cache of state up to an update id; rebuilt from rows, never the only copy
  id         String   @id @default(uuid()) @db.Uuid
  script_id  String   @db.Uuid
  upto_id    BigInt
  state      Bytes
  created_at DateTime @default(now())
  script     Script   @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@index([script_id, upto_id])
  @@map("script_snapshots")
}

model ScriptClient {
  // a Yjs clientID belongs to exactly one person, for every role (v4 #5)
  script_id  String   @db.Uuid
  client_id  BigInt
  person_id  String   @db.Uuid
  created_at DateTime @default(now())
  script     Script   @relation(fields: [script_id], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@id([script_id, client_id])
  @@index([person_id])
  @@map("script_clients")
}

model ScriptVersion {
  id            String   @id @default(uuid()) @db.Uuid
  script_id     String   @db.Uuid
  n             Int
  name          String? // "Mike's edits"; lint refuses internal markers
  kind          String // auto | named | restore | approved | import
  upto_id       BigInt // last ScriptUpdate included
  state         Bytes
  text          String // the BASE text, no pending suggestions (v4 #7)
  rows          Json // render rows for history and exports
  total_seconds Float?
  authors       Json // person ids since the previous version
  created_by    String?  @db.Uuid // null = autosave
  created_at    DateTime @default(now())
  script        Script   @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@unique([script_id, n])
  @@map("script_versions")
}

model ScriptAccess {
  id              String         @id @default(uuid()) @db.Uuid
  script_id       String         @db.Uuid
  person_id       String?        @db.Uuid
  organization_id String?        @db.Uuid // "Beech Acres · everyone"
  email           String?
  role            String // viewer | commenter | suggester | editor
  invited_by      String         @db.Uuid
  invited_at      DateTime       @default(now())
  accepted_at     DateTime?
  revoked_at      DateTime?
  expires_at      DateTime? // the job's end (freelancer test, §16)
  script          Script         @relation(fields: [script_id], references: [id], onDelete: Cascade)
  person          Person?        @relation(fields: [person_id], references: [id], onDelete: Cascade)
  organization    Organization?  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invites         ScriptInvite[]

  @@index([script_id])
  @@index([person_id])
  @@map("script_access")
}

model ScriptInvite {
  // 14 days; spent only by a TAP on its page, never on load (v4 #10)
  id         String       @id @default(uuid()) @db.Uuid
  access_id  String       @db.Uuid
  token_hash String       @unique
  created_at DateTime     @default(now())
  expires_at DateTime
  spent_at   DateTime?
  access     ScriptAccess @relation(fields: [access_id], references: [id], onDelete: Cascade)

  @@index([access_id])
  @@map("script_invites")
}

model ScriptComment {
  id          String    @id @default(uuid()) @db.Uuid
  script_id   String    @db.Uuid
  thread_id   String    @db.Uuid
  parent_id   String?   @db.Uuid
  author_id   String    @db.Uuid
  body        String
  anchor      Json? // Yjs relative positions {from, to}
  quote       String? // the text it was on, kept if the text goes
  suggestion  String? // a reply ON a suggestion: its id (v4 #12)
  audience    String    @default("office") // replies inherit the thread's (v4 #11)
  resolved_at DateTime?
  resolved_by String?   @db.Uuid
  created_at  DateTime  @default(now())
  script      Script    @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@index([script_id, thread_id])
  @@map("script_comments")
}

model ScriptApproval {
  // frozen, like §13's VersionApproval
  id          String   @id @default(uuid()) @db.Uuid
  script_id   String   @db.Uuid
  version_n   Int
  text_sha256 String // hash of the approved text (v4 #7)
  person_id   String   @db.Uuid
  name        String
  email       String
  ip          String?
  user_agent  String?
  note        String?
  created_at  DateTime @default(now())
  script      Script   @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@index([script_id])
  @@map("script_approvals")
}

model ScriptNotice {
  // batched: one email per person per 15 minutes
  id         String    @id @default(uuid()) @db.Uuid
  person_id  String    @db.Uuid
  script_id  String    @db.Uuid
  kind       String // mention | comment | suggestion | shared
  created_at DateTime  @default(now())
  sent_at    DateTime?
  person     Person    @relation(fields: [person_id], references: [id], onDelete: Cascade)
  script     Script    @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@index([person_id, sent_at])
  @@map("script_notices")
}
